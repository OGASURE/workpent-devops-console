      font-size: 11px;
      max-height: 260px;
      overflow: auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }
    footer {
      grid-column: 1 / 3;
      padding: 8px 16px;
      font-size: 11px;
      opacity: 0.7;
      display: flex;
      justify-content: space-between;
      border-top: 1px solid #22253a;
      background: #050717;
    }
    .kv-row {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      gap: 6px;
    }
    .kv-row span:first-child {
      opacity: 0.7;
    }
    .pill-group {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .pill {
      padding: 4px 8px;
      border-radius: 999px;
      border: 1px solid #252849;
      font-size: 11px;
    }
    .git-output {
      border-radius: 10px;
      border: 1px solid #252849;
      background: #050717;
      padding: 6px 8px;
      font-size: 11px;
      max-height: 160px;
      overflow: auto;
      white-space: pre-wrap;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }
    .input-commit {
      width: 100%;
      border-radius: 999px;
      border: 1px solid #252849;
      background: #050717;
      color: #f5f5ff;
      padding: 5px 10px;
      font-size: 12px;
      margin-bottom: 4px;
    }
    .muted {
      opacity: 0.7;
      font-size: 11px;
    }
  </style>
</head>
<body>
<div class="page">
  <!-- HEADER -->
  <header>
    <div>
      <div class="brand-title">WORKPENT HYPERDEV CONSOLE</div>
      <div class="brand-sub">KD-style project browser · OTP / SMS / payment API factory · App empire launcher</div>
    </div>
    <div class="stats">
      <div class="stat-pill">APPS: {{ apps|length }}</div>
      <div class="stat-pill">CPU: {{ '%.1f' % cpu_load }} load</div>
      <div class="stat-pill">MEM: {{ mem_used_pct }}% used</div>
      <div class="stat-pill">DISK: {{ disk_used_pct }}% used</div>
    </div>
  </header>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="wizard-card">
      <div class="label">AI APP WIZARD (IDEA CAPTURE ONLY)</div>
      <textarea placeholder="Describe your next API in plain English. OTP SMS, payment webhook, WhatsApp bot, etc."></textarea>
      <div style="margin-top: 8px; display:flex; justify-content:flex-end;">
        <button class="btn btn-sm" type="button">Save idea</button>
      </div>
    </div>

    <div class="create-card">
      <div class="label">CREATE NEW API (FASTAPI · SYSTEMD · NGINX)</div>
      <form method="post" action="/api/create-app">
        <div class="field-row">
          <small>API Name</small>
          <input type="text" name="app_name" placeholder="sms-api, payment-service, auth-api">
        </div>
        <div class="field-row">
          <small>Domain</small>
          <input type="text" name="domain_name" placeholder="api.workpent.com">
        </div>
        <div class="field-row">
          <small>Port</small>
          <input type="number" name="app_port" value="8100">
        </div>
        <div style="margin-top: 8px; display:flex; gap:6px; justify-content:flex-end;">
          <button class="btn btn-sm" type="submit">Create API Service</button>
          <button class="btn btn-secondary btn-sm" type="button">Fill example</button>
        </div>
      </form>
    </div>

    <div class="projects-card">
      <div class="projects-header">
        <span>PROJECTS</span>
        <span>{{ apps|length }} APPS</span>
      </div>
      {% for app in apps %}
      <a href="/?app_name={{ app.name }}" style="text-decoration:none; color:inherit;">
        <div class="project-item{% if selected_app and selected_app.name == app.name %} active{% endif %}">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span>{{ app.name }}</span>
            <span class="badge">
              <span class="badge-dot{% if app.status != 'RUNNING' %} stopped{% endif %}"></span>
              {{ app.status }}
            </span>
          </div>
          <div class="project-meta">
            {% if app.domain_name %}
              {{ app.domain_name }}
            {% elif app.app_port %}
              port {{ app.app_port }}
            {% else %}
              no domain/port
            {% endif %}
          </div>
          {% if app.created_at and app.updated_at %}
          <div class="project-meta">
            created {{ app.created_at }} · updated {{ app.updated_at }}
          </div>
          {% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    {% if not selected_app %}
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">NO APP SELECTED</div>
        </div>
        <p class="muted">
          Choose any app from the left "PROJECTS" list to view lifecycle controls, .env editor, dependencies and Git panel.
        </p>
      </div>
    {% else %}
    <div class="main-grid">
      <!-- LEFT COLUMN: Lifecycle + Env + Git -->
      <section class="panel">
        <div class="panel-header">
          <div>
            <div class="panel-title">LIFECYCLE · {{ selected_app.name }}</div>
            <div class="muted">{{ selected_app.base_path }}</div>
          </div>
          <div class="pill-group">
            <div class="pill">
              STATUS:
              {% if selected_app.status == 'RUNNING' %}
                <span style="color:#22c55e;">RUNNING</span>
              {% elif selected_app.status == 'STOPPED' %}
                <span style="color:#f97316;">STOPPED</span>
              {% else %}
                <span style="color:#eab308;">UNKNOWN</span>
              {% endif %}
            </div>
            {% if selected_app.created_at and selected_app.updated_at %}
            <div class="pill">
              Created {{ selected_app.created_at }} · Updated {{ selected_app.updated_at }}
            </div>
            {% endif %}
          </div>
        </div>

        <div class="panel-body">
          <!-- Lifecycle controls -->
          <div class="pill-group">
            <button class="btn btn-sm" type="button"
                    onclick="callServiceAction('{{ selected_app.name }}', 'start')">Start</button>
            <button class="btn btn-secondary btn-sm" type="button"
                    onclick="callServiceAction('{{ selected_app.name }}', 'stop')">Stop</button>
            <button class="btn btn-secondary btn-sm" type="button"
                    onclick="callServiceAction('{{ selected_app.name }}', 'restart')">Restart</button>

            {% if selected_app.domain_name %}
            <button class="btn-secondary btn-sm" type="button"
                    onclick="window.open('https://{{ selected_app.domain_name }}','_blank')">Preview</button>
            {% elif selected_app.app_port %}
            <button class="btn-secondary btn-sm" type="button"
                    onclick="window.open('http://{{ request.client.host }}:{{ selected_app.app_port }}','_blank')">
              Preview
            </button>
            {% endif %}
          </div>

          <!-- Health + Stats -->
          <div class="pill-group" style="margin-top:6px;">
            <button class="btn-secondary btn-sm" type="button"
                    onclick="loadHealth('{{ selected_app.name }}')">Health</button>
            <button class="btn-secondary btn-sm" type="button"
                    onclick="loadStats('{{ selected_app.name }}')">Stats</button>
          </div>

          <div id="health-box" class="git-output" style="margin-top:6px; display:none;"></div>
          <div id="stats-box" class="git-output" style="margin-top:6px; display:none;"></div>

          <!-- ENV EDITOR -->
          <hr style="border-color:#1f2937; margin:10px 0;">
          <div class="panel-title">ENVIRONMENT (.ENV)</div>
          <p class="muted">Secrets (KEY/SECRET/TOKEN/PASS) are stored unchanged; you just edit key/value pairs.</p>
          <textarea id="env-editor" class="env-editor" spellcheck="false">{% for k, v in env_data.items() %}{{ k }}={{ v }}
{% endfor %}</textarea>
          <div style="display:flex; justify-content:flex-end; gap:6px;">
            <button class="btn-secondary btn-sm" type="button"
                    onclick="reloadEnv('{{ selected_app.name }}')">Reload</button>
            <button class="btn btn-sm" type="button"
                    onclick="saveEnv('{{ selected_app.name }}')">Save .env</button>
          </div>

          <!-- GIT PANEL -->
          <hr style="border-color:#1f2937; margin:10px 0;">
          <div class="panel-title">GIT (BASIC WAR ROOM)</div>
          {% if not selected_app.has_git %}
            <p class="muted">
              This app is not yet a git repository.  
              From the server run inside <code>{{ selected_app.base_path }}</code>:
            </p>
            <pre class="log-box">git init
git add .
git commit -m "Initial commit"
git branch -M main
git remote add origin git@github.com:USER/REPO.git
git push -u origin main</pre>
          {% else %}
            <div class="kv-row">
              <span>Branch</span>
              <span id="git-branch">{{ selected_app.git_branch or 'unknown' }}</span>
            </div>
            <input id="git-commit-message" class="input-commit"
                   placeholder="Commit message (e.g. 'Improve shortlink stats endpoint')">
            <div style="display:flex; gap:6px; margin-bottom:4px;">
              <button class="btn-secondary btn-sm" type="button"
                      onclick="refreshGitStatus('{{ selected_app.name }}')">Status</button>
              <button class="btn btn-sm" type="button"
                      onclick="commitChanges('{{ selected_app.name }}')">Commit</button>
              <button class="btn-secondary btn-sm" type="button"
                      onclick="pushGit('{{ selected_app.name }}')">Push</button>
              <button class="btn-secondary btn-sm" type="button"
                      onclick="pullGit('{{ selected_app.name }}')">Pull</button>
            </div>
            <div class="muted">Last status / output:</div>
            <div id="git-output" class="git-output">Click "Status" to load git info.</div>
          {% endif %}
        </div>
      </section>

      <!-- RIGHT COLUMN: Dependencies + Clone/Update + Logs -->
      <section class="panel">
        <div class="panel-header">
          <div class="panel-title">DEPENDENCIES, CLONE / UPDATE, LOGS</div>
        </div>
        <div class="panel-body">

          <!-- Dependencies -->
          <div class="panel-title">DEPENDENCIES (PIP)</div>
          <p class="muted">
            Venv: {{ selected_app.base_path }}/.venv · Python / pip from that venv will be used.
          </p>
          <div style="display:flex; gap:6px; margin-bottom:4px;">
            <button class="btn-secondary btn-sm" type="button"
                    onclick="listDeps('{{ selected_app.name }}')">List packages</button>
            <button class="btn-secondary btn-sm" type="button"
                    onclick="listOutdatedDeps('{{ selected_app.name }}')">Outdated</button>
          </div>
          <form onsubmit="installPackage(event, '{{ selected_app.name }}')"
                style="display:flex; gap:6px; margin-bottom:4px;">
            <input type="text" id="pip-package" placeholder="fastapi==0.115.0"
                   style="flex:1; border-radius:999px; border:1px solid #252849; background:#050717; color:#f5f5ff; padding:5px 10px; font-size:12px;">
            <button class="btn-secondary btn-sm" type="submit">pip install</button>
          </form>
          <button class="btn-secondary btn-sm" type="button"
                  onclick="updateFromReqs('{{ selected_app.name }}')">Update via requirements.txt</button>

          <div id="deps-output" class="git-output" style="margin-top:6px;">No dependency output yet.</div>

          <!-- Clone / Update -->
          <hr style="border-color:#1f2937; margin:10px 0;">
          <div class="panel-title">CLONE / UPDATE</div>
          <form onsubmit="cloneApp(event, '{{ selected_app.name }}')" style="margin-bottom:6px;">
            <div class="field-row">
              <small>Clone as</small>
              <input type="text" id="clone-name" placeholder="new-app-name">
              <button class="btn-secondary btn-sm" type="submit">Clone app folder</button>
            </div>
          </form>

          <form id="zip-form" onsubmit="uploadZip(event, '{{ selected_app.name }}')" enctype="multipart/form-data">
            <div class="field-row">
              <small>Update from ZIP</small>
              <input type="file" id="zip-file" name="file" accept=".zip">
              <button class="btn-secondary btn-sm" type="submit">Upload ZIP &amp; update code</button>
            </div>
          </form>
          <p class="muted">
            ZIP update will keep your existing <code>.env</code>, <code>.git</code> and <code>.venv</code>,
            but replace other files.
          </p>

          <!-- Logs -->
          <hr style="border-color:#1f2937; margin:10px 0;">
          <div class="panel-title">SERVICE LOGS</div>
          <button class="btn-secondary btn-sm" type="button"
                  onclick="loadLogs('{{ selected_app.name }}')">Refresh logs</button>
          <pre id="logs-box" class="log-box">No logs loaded yet.</pre>

        </div>
      </section>
    </div>
    {% endif %}
  </main>

  <footer>
    <span>
      App base: /srv/workpent/apps · Snapshots: /srv/workpent/snapshots · Deleted: /srv/workpent/deleted-apps
    </span>
    <span>
      Workpent HyperDev Console · KD Project Browser · {{ (now() if false) }}
    </span>
  </footer>
</div>

<script>
async function callServiceAction(appName, action) {
  const res = await fetch(`/api/apps/${appName}/service/${action}`, {method: 'POST'});
  const data = await res.json();
  alert(`Service ${action}: ` + (data.ok ? data.status : data.error));
}

async function reloadEnv(appName) {
  const res = await fetch(`/api/apps/${appName}/env`);
  const data = await res.json();
  const textarea = document.getElementById('env-editor');
  textarea.value = '';
  for (const [k, v] of Object.entries(data)) {
    textarea.value += `${k}=${v}\n`;
  }
}

async function saveEnv(appName) {
  const textarea = document.getElementById('env-editor');
  const lines = textarea.value.split('\n');
  const entries = {};
  for (const line of lines) {
    if (!line.trim() || line.trim().startsWith('#')) continue;
    const idx = line.indexOf('=');
    if (idx === -1) continue;
    const key = line.slice(0, idx).trim();
    const value = line.slice(idx + 1).trim();
    entries[key] = value;
  }
  const res = await fetch(`/api/apps/${appName}/env/save`, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(entries),
  });
  if (res.ok) {
    alert('.env saved.');
  } else {
    alert('Error saving .env');
  }
}

async function loadHealth(appName) {
  const box = document.getElementById('health-box');
  box.style.display = 'block';
  box.textContent = 'Loading health...';
  try {
    const res = await fetch(`/api/apps/${appName}/health`);
    const data = await res.json();
    box.textContent = JSON.stringify(data, null, 2);
  } catch (e) {
    box.textContent = 'Error: ' + e;
  }
}

async function loadStats(appName) {
  const box = document.getElementById('stats-box');
  box.style.display = 'block';
  box.textContent = 'Loading stats...';
  try {
    const res = await fetch(`/api/apps/${appName}/stats`);
    const data = await res.json();
    box.textContent = JSON.stringify(data, null, 2);
  } catch (e) {
    box.textContent = 'Error: ' + e;
  }
}

async function listDeps(appName) {
  const box = document.getElementById('deps-output');
  box.textContent = 'Loading pip list...';
  const res = await fetch(`/api/apps/${appName}/deps`);
  box.textContent = await res.text();
}

async function listOutdatedDeps(appName) {
  const box = document.getElementById('deps-output');
  box.textContent = 'Loading pip outdated...';
  const res = await fetch(`/api/apps/${appName}/deps/outdated`);
  box.textContent = await res.text();
}

async function installPackage(event, appName) {
  event.preventDefault();
  const input = document.getElementById('pip-package');
  const pkg = input.value.trim();
  if (!pkg) return;
  const box = document.getElementById('deps-output');
  box.textContent = `Installing ${pkg}...`;
  const formData = new FormData();
  formData.append('package', pkg);
  const res = await fetch(`/api/apps/${appName}/deps/install`, {
    method: 'POST',
    body: formData,
  });
  box.textContent = await res.text();
}

async function updateFromReqs(appName) {
  const box = document.getElementById('deps-output');
  box.textContent = 'Updating from requirements.txt...';
  const res = await fetch(`/api/apps/${appName}/deps/update-from-reqs`, {method: 'POST'});
  box.textContent = await res.text();
}

async function cloneApp(event, appName) {
  event.preventDefault();
  const nameInput = document.getElementById('clone-name');
  const newName = nameInput.value.trim();
  if (!newName) {
    alert('Enter new app name');
    return;
  }
  const formData = new FormData();
  formData.append('new_name', newName);
  const res = await fetch(`/api/apps/${app_name}/clone`.replace('${app_name}', appName), {
    method: 'POST',
    body: formData,
  });
  const data = await res.json();
  if (data.ok) {
    alert('Cloned to ' + data.new_app + '. Reload page to see it in the list.');
  } else {
    alert('Error: ' + JSON.stringify(data));
  }
}

async function uploadZip(event, appName) {
  event.preventDefault();
  const fileInput = document.getElementById('zip-file');
  if (!fileInput.files.length) {
    alert('Choose a ZIP file first.');
    return;
  }
  const formData = new FormData();
  formData.append('file', fileInput.files[0]);
  const res = await fetch(`/api/apps/${appName}/update-from-zip`, {
    method: 'POST',
    body: formData,
  });
  if (res.ok) {
    alert('App code updated from ZIP (excluding .env, .git, .venv).');
  } else {
    alert('Error updating from ZIP');
  }
}

async function loadLogs(appName) {
  const box = document.getElementById('logs-box');
  box.textContent = 'Loading logs...';
  const res = await fetch(`/api/apps/${appName}/logs`);
  box.textContent = await res.text();
}

/* GIT functions */

async function refreshGitStatus(appName) {
  const box = document.getElementById('git-output');
  box.textContent = 'Loading git status...';
  try {
    const res = await fetch(`/api/apps/${appName}/git/status`);
    if (!res.ok) {
      box.textContent = 'Error: ' + (await res.text());
      return;
    }
    const data = await res.json();
    if (data.branch && document.getElementById('git-branch')) {
      document.getElementById('git-branch').textContent = data.branch;
    }
    let txt = '';
    txt += 'Branch: ' + (data.branch || 'unknown') + '\\n\\n';

    if (data.remotes && data.remotes.length) {
      txt += 'Remotes:\\n';
      for (const line of data.remotes) txt += '  ' + line + '\\n';
      txt += '\\n';
    }

    if (data.status_lines && data.status_lines.length) {
      txt += 'Status (short):\\n';
      for (const line of data.status_lines) txt += '  ' + line + '\\n';
      txt += '\\n';
    } else {
      txt += 'Working tree clean.\\n\\n';
    }

    if (data.recent_commits && data.recent_commits.length) {
      txt += 'Recent commits:\\n';
      for (const line of data.recent_commits) txt += '  ' + line + '\\n';
    }

    box.textContent = txt;
  } catch (e) {
    box.textContent = 'Error: ' + e;
  }
}

async function commitChanges(appName) {
  const msgInput = document.getElementById('git-commit-message');
  const msg = msgInput.value.trim();
  if (!msg) {
    alert('Enter a commit message first.');
    return;
  }
  const box = document.getElementById('git-output');
  box.textContent = 'Running git add . && git commit...';
  const res = await fetch(`/api/apps/${appName}/git/commit`, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({message: msg, stage_all: true}),
  });
  box.textContent = await res.text();
}

async function pushGit(appName) {
  const box = document.getElementById('git-output');
  box.textContent = 'Running git push...';
  const res = await fetch(`/api/apps/${appName}/git/push`, {method: 'POST'});
  box.textContent = await res.text();
}

async function pullGit(appName) {
  const box = document.getElementById('git-output');
  box.textContent = 'Running git pull...';
  const res = await fetch(`/api/apps/${appName}/git/pull`, {method: 'POST'});
  box.textContent = await res.text();
}
</script>
</body>
</html>

