def read_env_file(env_path: Path) -> Dict[str, str]:
    """Parse a simple KEY=VALUE .env file into a dict."""
    data: Dict[str, str] = {}
    if env_path.is_file():
        for line in env_path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            data[k.strip()] = v.strip()
    return data


def write_env_file(env_path: Path, data: Dict[str, str]) -> None:
    """Write a dict back to .env in KEY=VALUE form, sorted by key."""
    lines = []
    for k in sorted(data.keys()):
        v = data[k]
        lines.append(f"{k}={v}")
    env_path.write_text("\n".join(lines) + "\n")


def find_venv(app_dir: Path) -> Optional[Path]:
    """
    Try to locate a venv for an app.
    We support:
      - /srv/workpent/apps/<app>/.venv
      - /srv/workpent/apps/<app>/backend/.venv
    """
    candidates = [
        app_dir / ".venv",
        app_dir / "backend" / ".venv",
    ]
    for c in candidates:
        if c.is_dir():
            return c
    return None


def get_venv_paths(app_dir: Path) -> Dict[str, Optional[Path]]:
    """Return dict with venv dir, pip path, python path if found."""
    venv_dir = find_venv(app_dir)
    if not venv_dir:
        return {"venv_dir": None, "pip": None, "python": None}

    bin_dir = venv_dir / "bin"
    pip = bin_dir / "pip"
    python = bin_dir / "python"
    return {
        "venv_dir": venv_dir,
        "pip": pip if pip.is_file() else None,
        "python": python if python.is_file() else None,
    }


def run_pip_command(app_name: str, args: List[str]) -> Dict[str, str]:
    """
    Run pip command inside the app's venv.
    Returns {"ok": bool, "output": "..."} as strings.
    """
    app_dir = APPS_BASE_DIR / app_name
    paths = get_venv_paths(app_dir)
    pip_path = paths["pip"]
    if not pip_path:
        return {"ok": "false", "output": "No venv / pip found for this app."}

    try:
        proc = subprocess.run(
            [str(pip_path)] + args,
            capture_output=True,
            text=True,
        )
        out = (proc.stdout or "") + "\n" + (proc.stderr or "")
        return {
            "ok": "true" if proc.returncode == 0 else "false",
            "output": out.strip(),
        }
    except Exception as e:
        return {"ok": "false", "output": f"Error running pip: {e}"}


def detect_db_from_env(env: Dict[str, str]) -> Dict[str, str]:
    """
    Very light DB detection from DATABASE_URL.
    Supports:
      - sqlite:///path/to/db.sqlite3
      - postgres://... (just identifies type)
      - mysql://...    (just identifies type)
    """
    url = env.get("DATABASE_URL") or env.get("DB_URL") or ""
    url = url.strip()
    if not url:
        return {"type": "none", "url": "", "info": "No DATABASE_URL in .env"}

    lower = url.lower()
    if lower.startswith("sqlite:///"):
        return {
            "type": "sqlite",
            "url": url,
            "info": "SQLite database",
        }
    if lower.startswith("postgres://") or lower.startswith("postgresql://"):
        return {
            "type": "postgres",
            "url": url,
            "info": "PostgreSQL database (stats require client driver)",
        }
    if lower.startswith("mysql://") or lower.startswith("mysql+pymysql://"):
        return {
            "type": "mysql",
            "url": url,
            "info": "MySQL database (stats require client driver)",
        }

    return {
        "type": "unknown",
        "url": url,
        "info": "DATABASE_URL present but type not recognized.",
    }


def sqlite_db_stats(sqlite_url: str) -> Dict:
    """
    Given sqlite:///path/to/db.sqlite3, return basic stats:
      - db_path
      - tables: list of {name, row_count}
    """
    if not sqlite_url.lower().startswith("sqlite:///"):
        return {"error": "Not a sqlite URL."}

    path_str = sqlite_url[len("sqlite:///") :]
    db_path = Path(path_str)
    if not db_path.is_file():
        return {"error": f"SQLite file not found: {db_path}"}

    result = {"db_path": str(db_path), "tables": []}
    try:
        conn = sqlite3.connect(str(db_path))
        cur = conn.cursor()
        cur.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';"
        )
        tables = [row[0] for row in cur.fetchall()]
        for t in tables:
            try:
                cur.execute(f"SELECT COUNT(*) FROM {t}")
                count = cur.fetchone()[0]
            except Exception:
                count = "?"
            result["tables"].append({"name": t, "rows": count})
    except Exception as e:
        result["error"] = f"Error reading sqlite DB: {e}"
    finally:
        try:
            conn.close()
        except Exception:
            pass
    return result


class AppManager:
    """Core app discovery + stats for HyperDev."""

    @staticmethod
    def get_app_status(app_name: str) -> str:
        service = f"workpent-{app_name}.service"
        try:
            result = subprocess.run(
                ["systemctl", "is-active", service],
                capture_output=True,
                text=True,
            )
            return "running" if result.stdout.strip() == "active" else "stopped"
        except Exception:
            return "unknown"

    @staticmethod
    def list_apps() -> List[Dict]:
        """Return list of apps with env + status."""
        apps: List[Dict] = []
        if not APPS_BASE_DIR.exists():
            return apps

        for item in APPS_BASE_DIR.iterdir():
            if not item.is_dir():
                continue
            app_name = item.name
            env = read_env_file(item / ".env")
            status = AppManager.get_app_status(app_name)
            apps.append(
                {
                    "name": app_name,
                    "path": str(item),
                    "created": item.stat().st_ctime,
                    "status": status,
                    "domain": env.get("DOMAIN_NAME", ""),
                    "port": env.get("APP_PORT", ""),
                }
            )

        apps.sort(key=lambda x: x["created"], reverse=True)
        return apps

    @staticmethod
    def get_system_stats() -> Dict:
        """Very simple CPU / RAM / disk snapshot."""
        cpu = "N/A"
        mem = "N/A"
        disk = "N/A"

        # CPU
        try:
            top_out = subprocess.run(
                ["top", "-bn1"], capture_output=True, text=True
            ).stdout
            for line in top_out.splitlines():
                if "%Cpu(s)" in line:
                    parts = line.split()
                    if len(parts) >= 2:
                        cpu = parts[1] + "%"
                    break
        except Exception:
            pass

        # Memory
        try:
            free_out = subprocess.run(
                ["free", "-m"], capture_output=True, text=True
            ).stdout.splitlines()
            if len(free_out) > 1:
                parts = free_out[1].split()
                if len(parts) >= 3:
                    used = int(parts[2])
                    total = int(parts[1])
                    mem = f"{used / total * 100:.1f}%"
        except Exception:
            pass

        # Disk
        try:
            df_out = subprocess.run(
                ["df", "-h", "/"], capture_output=True, text=True
            ).stdout.splitlines()
            if len(df_out) > 1:
                parts = df_out[1].split()
                if len(parts) >= 5:
                    disk = parts[4]  # "Use%" column
        except Exception:
            pass

        return {"cpu": cpu, "memory": mem, "disk": disk}


