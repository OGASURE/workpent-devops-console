@app.post("/update-app", response_class=HTMLResponse)
async def update_app(
    request: Request,
    app_name: str = Form(...),
    zip_file: UploadFile = File(...),
) -> HTMLResponse:
    """
    Update an existing app from an uploaded ZIP:
      - Snapshot app first
      - Stop service
      - Extract ZIP into temp folder
      - Copy files into app folder (skipping .venv / __pycache__ / .git / .env)
      - If requirements.txt present, run pip install -r
      - Restart service
    """
    app_dir = APPS_BASE_DIR / app_name
    if not app_dir.is_dir():
        return HTMLResponse("<p class='error'>App not found.</p>")

    # Snapshot first
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    snap_dir = SNAPSHOT_BASE_DIR / app_name
    snap_dir.mkdir(parents=True, exist_ok=True)
    zip_base = snap_dir / f"{app_name}-update-{ts}"
    snap_path = shutil.make_archive(str(zip_base), "zip", app_dir)

    # Save uploaded ZIP to temp
    tmp_root = Path(tempfile.mkdtemp(prefix=f"{app_name}-update-"))
    upload_path = tmp_root / zip_file.filename
    with upload_path.open("wb") as f:
        while True:
            chunk = await zip_file.read(1024 * 1024)
            if not chunk:
                break
            f.write(chunk)

    extract_dir = tmp_root / "extract"
    extract_dir.mkdir(parents=True, exist_ok=True)
    try:
        shutil.unpack_archive(str(upload_path), str(extract_dir), "zip")
    except Exception as e:
        return HTMLResponse(
            f"<p class='error'>Failed to unpack ZIP: {e} (snapshot: {snap_path})</p>"
        )

    # If ZIP contains a single top-level folder, use that as root
    contents = list(extract_dir.iterdir())
    if len(contents) == 1 and contents[0].is_dir():
        src_root = contents[0]
    else:
        src_root = extract_dir

    # Stop service
    service = f"workpent-{app_name}.service"
    try:
        subprocess.run(["systemctl", "stop", service], capture_output=True, text=True)
    except Exception:
        pass  # Don't fail if service isn't there

    # Copy over files
    try:
        for root, dirs, files in os.walk(src_root):
            rel = Path(root).relative_to(src_root)
            # Skip heavy dirs
            if any(part in {".venv", "__pycache__", ".git"} for part in rel.parts):
                continue
            dest_dir = app_dir / rel
            dest_dir.mkdir(parents=True, exist_ok=True)

            for fname in files:
                if fname == ".env":
                    # Never overwrite .env from update ZIP
                    continue
                src_file = Path(root) / fname
                dest_file = dest_dir / fname
                shutil.copy2(src_file, dest_file)
    except Exception as e:
        return HTMLResponse(
            f"<p class='error'>Failed to copy files from ZIP: {e} (snapshot: {snap_path})</p>"
        )

    # If requirements.txt exists in app root, run pip install -r
    req = app_dir / "requirements.txt"
    if req.is_file():
        res = run_pip_command(app_name, ["install", "-r", str(req)])
        pip_msg = res["output"]
    else:
        pip_msg = "No requirements.txt, skipped pip install."

    # Restart service
    try:
        subprocess.run(["systemctl", "start", service], capture_output=True, text=True)
    except Exception:
        pass

    msg = (
        f"<span class='badge badge-ok'>Updated {app_name} from ZIP.</span>"
        f"<div class='ai-note'>Snapshot: <code>{snap_path}</code></div>"
        f"<pre class='log-box'>{pip_msg}</pre>"
    )
    return HTMLResponse(msg)


