@app.post("/restore-last", response_class=HTMLResponse)
async def restore_last(request: Request) -> HTMLResponse:
    data = await request.form()
    app_name = data.get("app_name")
    if not app_name:
        return HTMLResponse("<span class='error'>No app provided.</span>")

    snap_dir = SNAPSHOT_BASE_DIR / app_name
    if not snap_dir.is_dir():
        return HTMLResponse("<span class='error'>No snapshots found for this app.</span>")

    zips = sorted(snap_dir.glob(f"{app_name}-*.zip"))
    if not zips:
        return HTMLResponse("<span class='error'>No snapshots found for this app.</span>")

    latest = zips[-1]
    app_dir = APPS_BASE_DIR / app_name
    service = f"workpent-{app_name}.service"

    try:
        subprocess.run(["systemctl", "stop", service], capture_output=True, text=True)

        trash_dir = APPS_BASE_DIR.parent / "trash"
        trash_dir.mkdir(exist_ok=True)
        if app_dir.exists():
            new_name = trash_dir / f"{app_name}-{datetime.now().strftime('%Y%m%d-%H%M%S')}"
            shutil.move(str(app_dir), str(new_name))

        app_dir.mkdir(parents=True, exist_ok=True)
        shutil.unpack_archive(str(latest), str(app_dir), "zip")
        subprocess.run(["systemctl", "start", service], capture_output=True, text=True)

        return HTMLResponse(
            f"<span class='badge badge-ok'>Restored {app_name} from snapshot {latest.name}</span>"
        )
    except Exception as e:
        return HTMLResponse(
            f"<span class='error'>Failed to restore snapshot: {e}</span>"
        )


