    if not app_dir.is_dir():
        return "<p class='error'>App not found.</p>"

    env = read_env_file(app_dir / ".env")
    status = AppManager.get_app_status(app_name)
    status_html = render_status_badge(status)
    venv_info = get_venv_paths(app_dir)

    venv_dir = venv_info["venv_dir"]
    python_path = venv_info["python"]
    pip_path = venv_info["pip"]

    venv_lines = []
    if venv_dir:
        venv_lines.append(f"<div><span class='pill'>Venv: <code>{venv_dir}</code></span></div>")
    else:
        venv_lines.append("<div class='empty'>No virtualenv detected yet.</div>")

