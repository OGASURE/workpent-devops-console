@app.post("/clone-app", response_class=HTMLResponse)
async def clone_app(request: Request) -> HTMLResponse:
    data = await request.json()
    source_app = (data.get("source_app") or "").strip()
    new_app_name = (data.get("new_app_name") or "").strip()
    domain_name = (data.get("domain_name") or "").strip()
    app_port = (data.get("app_port") or "").strip()

    if not source_app or not new_app_name or not domain_name or not app_port:
        return HTMLResponse("<p class='error'>All fields are required.</p>")

    src_dir = APPS_BASE_DIR / source_app
    dst_dir = APPS_BASE_DIR / new_app_name

    if not src_dir.is_dir():
        return HTMLResponse("<p class='error'>Source app not found.</p>")
    if dst_dir.exists():
        return HTMLResponse("<p class='error'>Target app folder already exists.</p>")

    try:
        # Copy folder but skip heavy dirs
        def _ignore(dirpath, names):
            ignore = []
            for n in [".venv", "__pycache__", ".git"]:
                if n in names:
                    ignore.append(n)
            return ignore

        shutil.copytree(src_dir, dst_dir, ignore=_ignore)

        # Update .env in cloned app
        env_path = dst_dir / ".env"
        env = read_env_file(env_path)
        env["APP_NAME"] = new_app_name
        env["DOMAIN_NAME"] = domain_name
        env["APP_PORT"] = app_port
        write_env_file(env_path, env)

        msg = (
            f"<span class='badge badge-ok'>Cloned {source_app} → {new_app_name}</span>"
            "<div class='ai-note'>Now run your existing deploy script inside the new app folder "
            "to create systemd/nginx for this clone (the console does NOT touch infra).</div>"
        )
        return HTMLResponse(msg)
    except Exception as e:
        return HTMLResponse(f"<p class='error'>Failed to clone app: {e}</p>")


