@app.get("/download-app")
async def download_app(app_name: str):
    """Create a temporary zip of the app (excluding heavy dirs) and return it."""
    app_dir = APPS_BASE_DIR / app_name
    if not app_dir.is_dir():
        return JSONResponse({"error": "App not found"}, status_code=404)

    tmp_dir = Path(tempfile.mkdtemp(prefix=f"{app_name}-zip-"))

    def _ignore(dirpath, names):
        ignore_list = []
        for n in [".venv", "__pycache__", ".git"]:
            if n in names:
                ignore_list.append(n)
        return ignore_list

    try:
        copy_root = tmp_dir / app_name
        shutil.copytree(app_dir, copy_root, ignore=_ignore)
        zip_path = shutil.make_archive(str(tmp_dir / app_name), "zip", tmp_dir, app_name)
        return FileResponse(zip_path, filename=f"{app_name}.zip")
    finally:
        # Let OS clean tmp_dir later; avoids race with download.
        pass


@app.get("/list-files", response_class=HTMLResponse)
async def list_files(app_name: str, path: str = ".") -> HTMLResponse:
    """Return a simple HTML file tree for the modal."""
    base = APPS_BASE_DIR / app_name
    root = (base / path).resolve()
    try:
        root.relative_to(base.resolve())
    except ValueError:
        return HTMLResponse("<p>Invalid path.</p>")
    if not root.is_dir():
        return HTMLResponse("<p>Not a directory.</p>")

    entries = []
    for item in sorted(root.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower())):
        name = item.name
        if name in {".venv", "__pycache__", ".git"}:
            continue
        rel = str(item.relative_to(base)).replace("\\", "/")
        if item.is_dir():
            entries.append(
                f"<li><button onclick=\"loadFile('{app_name}','{rel}/__DIR__')\">{name}/</button></li>"
            )
        else:
            entries.append(
                f"<li><button onclick=\"loadFile('{app_name}','{rel}')\">{name}</button></li>"
            )
    html = "<ul>" + "".join(entries) + "</ul>"
    return HTMLResponse(html)


