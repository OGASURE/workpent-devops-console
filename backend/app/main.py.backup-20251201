    .btn-xs {{ font-size: 10px; padding: 3px 8px; }}

    .badge {{
      font-size: 10px;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid #1e293b;
      background: #020617;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }}
    .badge-ok {{
      background: var(--ok-soft);
      border-color: var(--ok-soft);
      color: var(--ok);
    }}
    .badge-bad {{
      background: var(--danger-soft);
      border-color: var(--danger-soft);
      color: var(--danger);
    }}
    .badge-unknown {{
      background: #4b556333;
      color: #e5e7eb;
    }}

    .pill {{
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
    }}

    .ai-note {{
      font-size: 11px;
      color: var(--muted);
      margin-top: 6px;
    }}

    .apps-sidebar {{
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 520px;
      overflow-y: auto;
    }}
    .apps-sidebar-header {{
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 4px;
    }}
    .app-row {{
      width: 100%;
      border-radius: 10px;
      border: 1px solid #111827;
      padding: 6px 8px;
      background: #020617;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      cursor: pointer;
    }}
    .app-row:hover {{
      border-color: var(--accent);
      background: #020617;
    }}
    .app-row-main {{
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-align: left;
      align-items: flex-start;
    }}
    .app-name {{
      font-size: 12px;
      font-weight: 500;
    }}
    .app-meta {{
      font-size: 11px;
      color: var(--muted);
    }}
    .app-row-status {{
      font-size: 10px;
    }}

    .empty {{
      font-size: 12px;
      color: var(--muted);
    }}

    .logs-panel {{
      background: #020617;
      border-radius: 10px;
      border: 1px solid #1f2937;
      padding: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 11px;
      max-height: 260px;
      overflow-y: auto;
      white-space: pre-wrap;
    }}

    .log-box {{
      background: #020617;
      border-radius: 10px;
      border: 1px solid #1f2937;
      padding: 6px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 11px;
      min-height: 60px;
      max-height: 200px;
      overflow-y: auto;
      white-space: pre-wrap;
    }}

    .error {{
      color: var(--danger);
      font-size: 12px;
    }}

    .footer {{
      margin-top: 14px;
      font-size: 11px;
      color: var(--muted);
      text-align: center;
    }}

    .app-detail-header {{
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }}
    .app-detail-title {{
      font-size: 16px;
      font-weight: 600;
    }}
    .app-detail-path {{
      font-size: 11px;
      color: var(--muted);
    }}

    .app-detail-grid {{
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 10px;
    }}

    .button-row {{
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 6px;
    }}

    .env-form-row {{
      display: flex;
      gap: 6px;
      margin-top: 6px;
    }}
    .env-form-row input {{
      flex: 1;
    }}

    .env-table-wrapper {{
      max-height: 180px;
      overflow-y: auto;
    }}

    table.simple {{
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }}
    table.simple th,
    table.simple td {{
      padding: 4px 6px;
      border-bottom: 1px solid #111827;
    }}
    table.simple th {{
      color: var(--muted);
      font-size: 11px;
      text-align: left;
    }}

    .divider {{
      border: none;
      border-top: 1px solid #111827;
      margin: 8px 0;
    }}

    /* Modal for code + files */
    .modal-backdrop {{
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 50;
    }}
    .modal {{
      background: #020617;
      border-radius: 16px;
      border: 1px solid #020617;
      width: min(1000px, 95vw);
      max-height: 90vh;
      display: flex;
      flex-direction: column;
    }}
    .modal-header {{
      padding: 10px 14px;
      border-bottom: 1px solid #020617;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
    }}
    .modal-body {{
      padding: 10px;
      overflow: auto;
      display: flex;
      gap: 10px;
    }}
    .file-tree {{
      width: 260px;
      border-right: 1px solid #020617;
      padding-right: 8px;
      overflow-y: auto;
      font-size: 12px;
    }}
    .file-tree ul {{
      list-style: none;
      padding-left: 10px;
    }}
    .file-tree button {{
      background: none;
      border: none;
      color: #e5e7eb;
      font-size: 12px;
      cursor: pointer;
      padding: 2px 0;
      text-align: left;
      width: 100%;
    }}
    .file-tree button:hover {{
      color: #f97316;
    }}
    .code-wrapper {{
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }}
    .code-view {{
      flex: 1;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12px;
      white-space: pre;
      background: #020617;
      border-radius: 8px;
      border: 1px solid #020617;
      padding: 8px;
      color: #e5e7eb;
      resize: none;
      min-height: 300px;
    }}
    .modal-footer {{
      border-top: 1px solid #020617;
      padding: 8px 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
    }}

    @media (max-width: 1080px) {{
      .grid {{
        grid-template-columns: minmax(0, 1fr);
      }}
    }}
  </style>
</head>
<body>
  <div class="shell">
    <header class="header">
      <div class="header-title">
        <h1><span style="opacity:0.6;">Workpent</span> HyperDev Console</h1>
        <div class="tagline">
          KD-style project browser • OTP / SMS / payment API factory • App empire launcher
        </div>
      </div>
      <div class="metrics">
        <div class="metric-card">
          <div class="metric-label">MANAGED APPS</div>
          <div class="metric-value">{len(apps)}</div>
          <div class="metric-label">on this VPS</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">CPU</div>
          <div class="metric-value">{stats['cpu']}</div>
          <div class="metric-label">load</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">MEMORY</div>
          <div class="metric-value">{stats['memory']}</div>
          <div class="metric-label">used</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">DISK</div>
          <div class="metric-value">{stats['disk']}</div>
          <div class="metric-label">root volume</div>
        </div>
      </div>
    </header>

    <div class="grid">
      <!-- LEFT: AI Wizard + Create -->
      <section class="card">
        <div class="card-header">
          <div class="card-title">AI APP WIZARD</div>
          <span class="badge">Idea capture only (safe)</span>
        </div>
        <form hx-post="/ai-idea" hx-target="#ai-idea-result" hx-swap="innerHTML">
          <textarea name="idea"
            placeholder="Describe your next API in plain English. Example: WhatsApp OTP service with Redis caching, rate limiting, admin dashboard, webhook callbacks..."
          ></textarea>
          <div style="margin-top:8px;">
            <button class="btn btn-primary btn-sm" type="submit">Save idea</button>
          </div>
        </form>
        <div id="ai-idea-result" class="ai-note"></div>

        <hr class="divider" />

        <div class="card-header">
          <div class="card-title">CREATE NEW API</div>
          <span class="badge">FastAPI · systemd · nginx</span>
        </div>
        <form id="create-app-form"
              hx-post="/create-app"
              hx-target="#create-result"
              hx-swap="innerHTML">
          <div class="field">
            <label>API Name</label>
            <input name="app_name" id="app_name"
              placeholder="sms-api, payment-service, auth-api"
              required pattern="[a-z0-9-]+" />
          </div>
          <div class="field">
            <label>Domain Name</label>
            <input name="domain_name" id="domain_name"
              placeholder="api.workpent.com" required />
          </div>
          <div class="field">
            <label>Port Number (internal gunicorn port)</label>
            <input name="app_port" id="app_port"
              type="number" min="8000" max="9000" value="8100" required />
          </div>
          <div style="display:flex;gap:8px;align-items:center;margin-top:4px;">
            <button class="btn btn-primary btn-sm" type="submit">Create API Service</button>
            <button class="btn btn-ghost btn-sm" type="button" onclick="fillExample()">Fill Example</button>
            <button class="btn btn-ghost btn-sm" type="button" onclick="clearForm()">Clear</button>
          </div>
        </form>
        <div id="create-result" class="ai-note"></div>
      </section>

      <!-- MIDDLE: KD-style apps sidebar -->
      <section class="card">
        <div class="apps-sidebar-header">
          <div class="card-title">PROJECTS</div>
          <span class="badge">{len(apps)} apps</span>
        </div>
        <div class="apps-sidebar" id="apps-sidebar">
          {apps_sidebar}
        </div>
      </section>

      <!-- RIGHT: App detail (env, deps, DB, logs...) -->
      <section class="card">
        <div id="app-detail">
          <p class="empty">
            Select an app on the left sidebar to view lifecycle controls, .env editor,
            dependencies, DB stats and logs.
          </p>
        </div>
      </section>
    </div>

    <section class="card" style="margin-top:10px;">
      <div class="card-header">
        <div class="card-title">System &amp; Intelligence</div>
      </div>
      <div class="system-grid">
        <div><span class="pill">Apps base: <code>{APPS_BASE_DIR}</code></span></div>
        <div><span class="pill">Template: FastAPI + systemd + nginx</span></div>
        <div><span class="pill">Port range: 8000–9000</span></div>
        <div><span class="pill">Creator CLI: <code>{CREATE_CMD}</code></span></div>
      </div>
      <div class="ai-note">
        This console never edits systemd / nginx / deploy scripts – it only uses them.
        All app lifecycle &amp; EPIC 1 features stay inside /srv/workpent/apps.
      </div>
    </section>

    <footer class="footer">
      Workpent HyperDev Console · KD Project Browser ·
      <span id="time" hx-get="/time" hx-trigger="load, every 1s"
            hx-swap="innerHTML"></span>
    </footer>
  </div>

  <!-- FILE BROWSER + CODE EDITOR MODAL -->
  <div class="modal-backdrop" id="code-modal-backdrop">
    <div class="modal">
      <div class="modal-header">
        <div id="code-modal-title">Code &amp; Files</div>
        <button class="btn btn-ghost btn-sm" onclick="closeCodeModal()">Close</button>
      </div>
      <div class="modal-body">
        <div class="file-tree" id="file-tree">
          <!-- filled from /list-files -->
        </div>
        <div class="code-wrapper">
          <textarea id="code-modal-content" class="code-view">// Select a file on the left to view/edit.</textarea>
        </div>
      </div>
      <div class="modal-footer">
        <div style="display:flex;gap:6px;align-items:center;">
          <button class="btn btn-ghost btn-sm" onclick="saveCurrentFile()">Save file</button>
          <button class="btn btn-ghost btn-sm" onclick="askAiForCode()">Ask AI to improve selection</button>
        </div>
        <div id="code-modal-status" style="color:#9ca3af;"></div>
      </div>
    </div>
  </div>

  <script>
    // -------- CREATE FORM HELPERS ----------
    function fillExample() {{
      document.getElementById('app_name').value = 'sms-api';
      document.getElementById('domain_name').value = 'sms.workpent.com';
      document.getElementById('app_port').value = '8110';
    }}
    function clearForm() {{
      document.getElementById('create-app-form').reset();
      document.getElementById('create-result').textContent = '';
    }}

    // -------- APP DETAIL LOADING (KD sidebar) ----------
    let currentApp = null;
    function loadAppDetail(appName) {{
      currentApp = appName;
      fetch(`/app-detail/${{encodeURIComponent(appName)}}`)
        .then(r => r.text())
        .then(html => {{
          document.getElementById('app-detail').innerHTML = html;
        }})
        .catch(() => {{
          document.getElementById('app-detail').innerHTML =
            '<p class="error">Failed to load app detail.</p>';
        }});
    }}

    // -------- SERVICE ACTIONS ----------
    function serviceAction(appName, action) {{
      fetch('/app-action', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{ app_name: appName, action: action }})
      }})
      .then(r => r.json())
      .then(data => {{
        const el = document.getElementById('app-action-result');
        if (el) el.textContent = data.message || '';
      }});
    }}

    function loadLogs(appName) {{
      fetch(`/app-logs?app_name=${{encodeURIComponent(appName)}}`)
        .then(r => r.text())
        .then(text => {{
          const el = document.getElementById('logs-panel');
          if (el) el.textContent = text;
        }});
    }}

    function snapshotApp(appName) {{
      const fd = new FormData();
      fd.append('app_name', appName);
      fetch('/snapshot-app', {{ method: 'POST', body: fd }})
        .then(r => r.text())
        .then(html => {{
          const el = document.getElementById('app-action-result');
          if (el) el.innerHTML = html;
        }});
    }}

    function restoreLast(appName) {{
      const fd = new FormData();
      fd.append('app_name', appName);
      fetch('/restore-last', {{ method: 'POST', body: fd }})
        .then(r => r.text())
        .then(html => {{
          const el = document.getElementById('app-action-result');
          if (el) el.innerHTML = html;
        }});
    }}

    function deleteApp(appName) {{
      if (!confirm(`Soft delete ${{appName}}?`)) return;
      const fd = new FormData();
      fd.append('app_name', appName);
      fetch('/delete-app', {{ method: 'POST', body: fd }})
        .then(r => r.text())
        .then(html => {{
          const el = document.getElementById('app-action-result');
          if (el) el.innerHTML = html;
        }});
    }}

    function downloadApp(appName) {{
      window.open(`/download-app?app_name=${{encodeURIComponent(appName)}}`, '_blank');
    }}

    // -------- ENV EDITOR ----------
    function editEnvEntry(key, value) {{
      document.getElementById('env-key').value = key;
      document.getElementById('env-value').value = value;
    }}

    function deleteEnvEntry(key) {{
      if (!currentApp) return;
      if (!confirm(`Delete env key ${{key}}?`)) return;
      fetch('/env-delete', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{
          app_name: currentApp,
          key: key
        }})
      }})
      .then(r => r.text())
      .then(html => {{
        document.getElementById('app-detail').innerHTML = html;
      }});
    }}

    function submitEnvForm(ev, appName) {{
      ev.preventDefault();
      const key = document.getElementById('env-key').value.trim();
      const value = document.getElementById('env-value').value;
      if (!key) return;
      fetch('/env-save', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{
          app_name: appName,
          key: key,
          value: value
        }})
      }})
      .then(r => r.text())
      .then(html => {{
        document.getElementById('app-detail').innerHTML = html;
      }});
    }}

    // -------- DEPENDENCY MANAGER ----------
    function loadDeps(appName) {{
      fetch(`/deps-list/${{encodeURIComponent(appName)}}`)
        .then(r => r.text())
        .then(txt => {{
          const el = document.getElementById('deps-output');
          if (el) el.textContent = txt;
        }});
    }}

    function loadDepsOutdated(appName) {{
      fetch(`/deps-outdated/${{encodeURIComponent(appName)}}`)
        .then(r => r.text())
        .then(txt => {{
          const el = document.getElementById('deps-output');
          if (el) el.textContent = txt;
        }});
    }}

    function installPackage(ev, appName) {{
      ev.preventDefault();
      const pkg = document.getElementById('deps-package').value.trim();
      if (!pkg) return;
      fetch('/deps-install', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{
          app_name: appName,
          package: pkg
        }})
      }})
      .then(r => r.text())
      .then(html => {{
        document.getElementById('app-detail').innerHTML = html;
      }});
    }}

    function upgradeAllDeps(appName) {{
      if (!confirm('Upgrade all outdated packages via pip?')) return;
      fetch('/deps-upgrade-all', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{ app_name: appName }})
      }})
      .then(r => r.text())
      .then(html => {{
        document.getElementById('app-detail').innerHTML = html;
      }});
    }}

    // -------- CLONE & UPDATE ----------
    function cloneApp(ev, sourceApp) {{
      ev.preventDefault();
      const name = document.getElementById('clone-name').value.trim();
      const domain = document.getElementById('clone-domain').value.trim();
      const port = document.getElementById('clone-port').value.trim();
      if (!name || !domain || !port) return;

      fetch('/clone-app', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{
          source_app: sourceApp,
          new_app_name: name,
          domain_name: domain,
          app_port: port
        }})
      }})
      .then(r => r.text())
      .then(html => {{
        document.getElementById('clone-update-result').innerHTML = html;
      }});
    }}

    function updateAppZip(ev, appName) {{
      ev.preventDefault();
      const input = document.getElementById('update-zip');
      if (!input.files.length) return;
      const fd = new FormData();
      fd.append('app_name', appName);
      fd.append('zip_file', input.files[0]);
      fetch('/update-app', {{
        method: 'POST',
        body: fd
      }})
      .then(r => r.text())
      .then(html => {{
        document.getElementById('clone-update-result').innerHTML = html;
      }});
    }}

    // -------- FILE BROWSER MODAL ----------
    let currentCodeApp = null;
    let currentCodePath = null;

    function openFileBrowser(appName) {{
      currentCodeApp = appName;
      currentCodePath = null;
      const backdrop = document.getElementById('code-modal-backdrop');
      const title = document.getElementById('code-modal-title');
      const content = document.getElementById('code-modal-content');
      const status = document.getElementById('code-modal-status');
      const tree = document.getElementById('file-tree');
      title.textContent = appName + ' · files';
      content.value = '// Select a file on the left to view/edit.';
      status.textContent = '';
      backdrop.style.display = 'flex';
      fetch(`/list-files?app_name=${{encodeURIComponent(appName)}}&path=.`)
        .then(r => r.text())
        .then(html => {{ tree.innerHTML = html; }})
        .catch(() => {{ tree.innerHTML = '<p>Error loading file list.</p>'; }});
    }}

    function loadFile(appName, relPath) {{
      currentCodeApp = appName;
      currentCodePath = relPath;
      const content = document.getElementById('code-modal-content');
      const status = document.getElementById('code-modal-status');
      status.textContent = 'Loading ' + relPath + ' ...';
      fetch(`/view-file?app_name=${{encodeURIComponent(appName)}}&path=${{encodeURIComponent(relPath)}}`)
        .then(r => r.text())
        .then(txt => {{
          content.value = txt;
          status.textContent = relPath;
        }})
        .catch(() => {{
          content.value = '// Error loading file';
          status.textContent = 'Failed to load file.';
        }});
    }}

    function closeCodeModal() {{
      document.getElementById('code-modal-backdrop').style.display = 'none';
    }}

    function saveCurrentFile() {{
      if (!currentCodeApp || !currentCodePath) {{
        alert('Select a file first.');
        return;
      }}
      const content = document.getElementById('code-modal-content').value;
      const status = document.getElementById('code-modal-status');
      status.textContent = 'Saving...';
      fetch('/save-file', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{
          app_name: currentCodeApp,
          path: currentCodePath,
          content: content
        }})
      }})
      .then(r => r.json())
      .then(data => {{
        status.textContent = data.message || 'Saved.';
      }})
      .catch(() => {{
        status.textContent = 'Error saving file.';
      }});
    }}

    function askAiForCode() {{
      if (!currentCodeApp || !currentCodePath) {{
        alert('Select a file first.');
        return;
      }}
      const textarea = document.getElementById('code-modal-content');
      const status = document.getElementById('code-modal-status');
      const selection = window.getSelection().toString() || textarea.value;
      status.textContent = 'Thinking...';
      fetch('/ai-suggest', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{
          app_name: currentCodeApp,
          file_path: currentCodePath,
          selection: selection,
          instruction: 'Suggest safe improvements and bug fixes for this code.'
        }})
      }})
      .then(r => r.json())
      .then(data => {{
        status.textContent = data.message || 'AI suggestion ready.';
        if (data.suggestion) {{
          alert('AI suggestion:\\n\\n' + data.suggestion);
        }}
      }})
      .catch(() => {{
        status.textContent = 'Error contacting AI.';
      }});
    }}
  </script>
</body>
</html>
"""
    return HTMLResponse(html)


# ---------------------------------------------------------------------------
# SMALL ROUTES / PARTIALS
# ---------------------------------------------------------------------------

@app.get("/time", response_class=HTMLResponse)
async def time_partial() -> HTMLResponse:
    return HTMLResponse(datetime.now().strftime("%Y-%m-%d %H:%M:%S"))


@app.get("/app-detail/{app_name}", response_class=HTMLResponse)
async def app_detail(app_name: str) -> HTMLResponse:
    return HTMLResponse(render_app_detail(app_name))


@app.post("/create-app", response_class=HTMLResponse)
async def create_app(
    app_name: str = Form(...),
    domain_name: str = Form(...),
    app_port: str = Form(...),
) -> HTMLResponse:
    """Call workpent-create CLI. We don't touch systemd/nginx templates."""
    try:
        proc = subprocess.run(
            [CREATE_CMD, app_name, domain_name, app_port],
            capture_output=True,
            text=True,
        )
        output = (proc.stdout or "") + "\n" + (proc.stderr or "")
        if proc.returncode == 0:
            return HTMLResponse(
                f"<span class='badge badge-ok'>Created {app_name}</span><pre class='log-box'>{output}</pre>"
            )
        return HTMLResponse(
