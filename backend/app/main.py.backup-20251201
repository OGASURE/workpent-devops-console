def render_status_badge(status: str) -> str:
    if status == "running":
        return "<span class='badge badge-ok'>RUNNING</span>"
    if status == "stopped":
        return "<span class='badge badge-bad'>STOPPED</span>"
    return "<span class='badge badge-unknown'>UNKNOWN</span>"


def render_apps_sidebar(apps: List[Dict]) -> str:
    """Left-sidebar style app list (KD-style project browser)."""
    if not apps:
        return "<p class='empty'>No apps yet. Create one on the left.</p>"

    rows = []
    for app in apps:
        status_html = render_status_badge(app["status"])
        domain = app.get("domain") or ""
        port = app.get("port") or ""
        meta = []
        if domain:
            meta.append(domain)
        if port:
            meta.append(f"port {port}")
        meta_str = " · ".join(meta) if meta else "&nbsp;"

        rows.append(
            f"""
            <button class="app-row"
                    onclick="loadAppDetail('{app['name']}')">
                <div class="app-row-main">
                    <div class="app-name">{app['name']}</div>
                    <div class="app-meta">{meta_str}</div>
                </div>
                <div class="app-row-status">{status_html}</div>
            </button>
            """
        )

    return "\n".join(rows)


def render_env_table(env: Dict[str, str]) -> str:
    if not env:
        return "<p class='empty'>No entries in .env yet.</p>"

    rows = []
    for k, v in sorted(env.items()):
        masked = v
        if any(s in k.upper() for s in ["KEY", "SECRET", "TOKEN", "PASS"]):
            masked = "••••••••"
        rows.append(
            f"""
            <tr>
              <td><code>{k}</code></td>
              <td>{masked}</td>
              <td>
                <button class="btn btn-ghost btn-xs"
                        onclick="editEnvEntry('{k}', '{v.replace('\"','&quot;')}')">
                  Edit
                </button>
                <button class="btn btn-ghost btn-xs"
                        onclick="deleteEnvEntry('{k}')">
                  Delete
                </button>
              </td>
            </tr>
            """
        )
    return "\n".join(rows)


def render_db_block(env: Dict[str, str]) -> str:
    meta = detect_db_from_env(env)
    if meta["type"] == "none":
        return "<p class='empty'>No DATABASE_URL configured.</p>"

    if meta["type"] == "sqlite":
        stats = sqlite_db_stats(meta["url"])
        if "error" in stats:
            return f"<p class='error'>{stats['error']}</p>"

        rows = []
        for t in stats["tables"]:
            rows.append(
                f"<tr><td><code>{t['name']}</code></td><td>{t['rows']}</td></tr>"
            )

        table_html = (
            "<table class='simple'><thead>"
            "<tr><th>Table</th><th>Rows</th></tr>"
            "</thead><tbody>"
            + "".join(rows)
            + "</tbody></table>"
        )

        return (
            f"<p class='pill'>SQLite DB: <code>{stats['db_path']}</code></p>"
            + table_html
        )

    # For now, non-sqlite: just show type & URL info
    return (
        f"<p class='pill'>DB Type: {meta['type']}</p>"
        f"<p class='pill'>URL: <code>{meta['url']}</code></p>"
        f"<p class='empty'>{meta['info']}</p>"
    )


