@app.post("/app-action")
async def app_action(request: Request):
    payload = await request.json()
    app_name = payload.get("app_name")
    action = payload.get("action")
    if not app_name or action not in {"start", "stop", "restart"}:
        return JSONResponse(
            {"status": "error", "message": "Invalid app_name or action"}, status_code=400
        )

    service_name = f"workpent-{app_name}.service"
    try:
        result = subprocess.run(
            ["systemctl", action, service_name],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            return JSONResponse(
                {"status": "success", "message": f"{action.title()}ed {app_name}"}
            )
        return JSONResponse(
            {
                "status": "error",
                "message": result.stderr or f"Failed to {action} service",
            }
        )
    except Exception as e:
        return JSONResponse({"status": "error", "message": str(e)})


